{
  "description": "Keeps the Fábrica de Asas rules in ~/.claude/rules/fabrica-de-asas/ in sync and blocks git commands that destroy saved versions or upload secrets.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/preferences.sh\" session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/guard-git.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
