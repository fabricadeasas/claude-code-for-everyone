{
  "description": "Mantém as preferências da Fábrica de Asas em ~/.claude/rules/fabrica-de-asas/ atualizadas e bloqueia comandos do git que apagam versões guardadas ou mandam senhas para a nuvem.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/preferences.sh\" session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/guard-git.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
